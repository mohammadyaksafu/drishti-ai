# ---------- DRISHTI AI :: local ML worker ----------
# Same Atlas cluster the Node API uses — the worker talks to MongoDB directly,
# so this machine never needs to be publicly reachable.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/drishti_ai?retryWrites=true&w=majority
MONGODB_DB=drishti_ai

# Model
MODEL_PATH=./models/best.pt
USE_MOCK_MODEL=true
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
MODEL_VERSION=drishti-yolov8n-v1

# Cloudinary (same account as the Node backend)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Worker behaviour
POLL_INTERVAL_SECONDS=6
MAX_ATTEMPTS=3
WORKER_ID=local-gpu-01
