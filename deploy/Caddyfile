# DRISHTI AI — Caddy site config (used on servers where nginx is not installed).
# Serves the built React app and proxies /api to the Node API, so the frontend
# talks to the API on the same origin. Run by deploy/setup-vps.sh in a
# caddy:2-alpine container on the host network.
{
	admin off
	auto_https off
}

:{$DRISHTI_PORT:8090} {
	encode gzip

	request_body {
		max_size 10MB
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:5000
	}

	# Hashed build assets never change — cache them hard.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Client-side routes (/map, /report/:id, …) survive a hard refresh.
	handle {
		root * /srv/drishti
		try_files {path} /index.html
		file_server
	}
}
