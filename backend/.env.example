# ---------- DRISHTI AI :: Node backend ----------
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/drishti_ai?retryWrites=true&w=majority

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Bootstrap admin: any user registering with this email gets the "admin" role
ADMIN_EMAIL=admin@drishti.ai
